# ============================================================
#  Copia este archivo a  .env  (cp .env.ejemplo .env)
#  y pon tu clave. El .env NO se sube a git.
# ============================================================

# Clave de la API de Gemini. Sacala en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo. Medido con el prompt real de este proyecto (mediana en caliente):
#   models/gemini-3.1-flash-lite   ~1.9 s   500 peticiones/dia, 15/min  <- recomendado
#   models/gemini-3.8-flash        ~7.4 s    20 peticiones/dia,  5/min
#   models/gemini-3.7-flash       ~36   s    20 peticiones/dia,  5/min
# La cuota importa mas que la velocidad: los "flash" normales solo dan 20
# peticiones al dia en el plan gratuito y se agotan en una sesion de pruebas.
# Evita ademas los modelos "preview": su latencia es impredecible.
GEMINI_MODELO=models/gemini-3.1-flash-lite

# Nivel de razonamiento: low | medium | high
# 'low' es lo recomendado: traducir una orden a un comando no necesita mas.
GEMINI_PENSAMIENTO=low

# Cuanto esperar al modelo, en milisegundos. 0 = sin limite (recomendado).
# La latencia de Gemini es muy irregular (medido en el mismo modelo y minuto:
# 1.8 s, 18 s y mas de 45 s), asi que cualquier tope acaba cortando respuestas
# que iban a llegar bien.
GEMINI_TIMEOUT_MS=0
